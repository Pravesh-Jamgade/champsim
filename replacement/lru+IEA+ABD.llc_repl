#include "cache.h"
#define PrefecctWindow 10000
//=============================DK=========================================//
uint32_t Prefetch_evict_count=0;

uint32_t windowCount=0;
float Overallaccuracy=0;
// initialize replacement state
void CACHE::llc_initialize_replacement()
{
  

   
}

// find replacement victim
uint32_t CACHE::llc_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    uint32_t way = 0;
    uint32_t max_lru_pfBlock=0;
    int max_lru=-1;
    uint8_t flag=0;
    // fill invalid line first
    for (way=0; way<NUM_WAY; way++) {
        if (block[set][way].valid == false) {
            return way;
        }
    }
    //if there is no invalid block then find
    //prefetch block with highest lru value.
    
    if(Overallaccuracy>perSetAccuracy[set][persetpfaccuracy])
    {
        for(way=0 ;way<LLC_WAY;way++)
        {
           
            if(block[set][way].prefetch==true && (int)block[set][way].lru>max_lru)
            {
                max_lru=(int)block[set][way].lru;
                max_lru_pfBlock=way;
                flag=1;
            }
        }
    
        if(flag==1)
        {
            Prefetch_evict_count++;
            return max_lru_pfBlock;
        }
    }
    
    // if there is no prefetch block then find LRU position block
    for(way=0;way<LLC_WAY;way++)
    {
        if(block[set][way].lru==LLC_WAY-1)
        {
            return way;
        }
    }
    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

vector<pair<uint32_t,uint32_t>> CACHE::CollectPfBlock(uint32_t set)
{
    vector<pair<uint32_t,uint32_t>>pfblock;
    for(uint32_t way=0;way<LLC_WAY;way++)
    {
        if(block[set][way].prefetch==1)
        {
            pfblock.push_back({block[set][way].lru,way});
        }
    }
    return pfblock;
}


