// called on every cache hit and cache fill
void CACHE::llc_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    
    if(pfCount==PrefecctWindow)
    {
        //cout<<"Prefetch Useful: "<<pf_useful<<" ";
        pfCount=0;
        windowCount++;
        Overallaccuracy= (float)pf_useful/(pf_useful+pf_useless) *100;
        llcPSA_resetpfstats(set);
    }

    if(hit) //Promotion
    {
        for (uint32_t i=0; i<NUM_WAY; i++) {
        if (block[set][i].lru < block[set][way].lru) {
            block[set][i].lru++;
        }
        }
        block[set][way].lru = 0;
    }

    
    else//Insertion
    {
        
        if(type==PREFETCH && block[set][way].prefetch==1)
        {
            
                vector<pair<uint32_t,uint32_t>>pfBlock; //<first,second><lru,way>
                pfBlock=CollectPfBlock(set);
                //cout<<"evicted way: "<<way<<" ";
                sort(pfBlock.begin(),pfBlock.end());
                // if(pfBlock.size()>=1)
                // {
                //     for(auto &it:pfBlock)
                //     {
                //         cout<<it.second<<" "<<it.first<<" ";
                //     }
                //     cout<<endl;
                // }  
                if(pfBlock.size()==1)
                {
                    uint32_t LeastPflru=block[set][way].lru;
                    block[set][way].lru=LeastPflru;
                }   
                else if(pfBlock.size()>1)
                {
                    uint32_t Tlru=pfBlock[0].first;
                    for(uint32_t i=0;i<pfBlock.size()-1;i++)
                    {
                        uint32_t Tway=pfBlock[i].second;
                        block[set][Tway].lru=pfBlock[i+1].first;
                    }
                    block[set][way].lru=Tlru;
                 
                }       
        }
        else if((type==PREFETCH && block[set][way].prefetch==0)||type!=PREFETCH)
        {
            //insert the block at the position suggested by IPV.
            for (uint32_t i=0; i<NUM_WAY; i++) {
            if (block[set][i].lru < block[set][way].lru) {
            block[set][i].lru++;
            }
            }
            block[set][way].lru = 0;

        }
    }   
}

// use this function to print out your own stats at the end of simulation
void CACHE::llc_replacement_final_stats()
{
    cout<<"number of times prefetch block evicted: "<<Prefetch_evict_count<<endl;
    for(int i=0;i<LLC_WAY;i++)
    {
        cout<<"Way ["<<i<<"] "<<": "<<PLPH[i]<<endl;
        
    }
}
