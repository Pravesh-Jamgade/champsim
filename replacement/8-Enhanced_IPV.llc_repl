#define NUM_POLICY 8
#define SDM_SIZE 32
#define TOTAL_SDM_SETS NUM_CPUS*NUM_POLICY*SDM_SIZE
#define PSEL_WIDTH 10
#define PSEL_MAX ((1<<PSEL_WIDTH)-1)
#define PSEL_THRS PSEL_MAX/2
uint32_t PVCP=0; //prefetch vector called
uint32_t DVCP=0; //Demand vector called
uint32_t PVCI=0; //prefetch vector called
uint32_t DVCI=0;
uint32_t RPIPV[NUM_POLICY][2][LLC_WAY+1]={
        {
            {0,0,0,0,1,3,4,3,0,2,3,0,7,3,1,15,0},
            {0,0,1,1,1,4,3,0,4,0,3,5,4,10,12,15,15}
        },
        {
            {0,0,0,0,1,2,3,4,0,2,4,8,0,1,15,14},
            {0,0,0,0,1,4,2,4,5,5,10,3,12,13,7,15,15}
        },
        {
            {0,0,1,3,0,0,5,0,6,3,0,6,6,12,8,7,10},
            {0,0,1,2,1,0,2,0,2,0,1,10,11,13,10,10,13}
        },
        {
            {0,0,0,0,1,0,0,6,0,5,0,9,6,5,1,14,15},
            {0,0,0,0,1,5,3,5,7,2,0,9,0,4,1,15,15}

        },
        {
            {0,0,0,0,2,2,3,0,1,0,7,5,6,4,2,11,12},
            {0,0,0,0,0,2,2,0,1,3,5,2,5,3,2,15,15}
        },
        {
            {0,0,2,0,3,5,3,0,6,9,7,3,6,4,4,10,13},
            {0,0,0,1,1,2,2,1,2,0,0,9,10,12,1,13,15}
        },
        {
            {0,0,0,1,1,4,4,5,0,2,2,5,7,5,1,15,15},
            {0,0,0,0,4,0,1,6,6,7,4,11,10,10,2,5,11}
        },
        {
            {0,0,2,3,1,0,5,6,3,7,2,5,0,9,4,7,2},
            {0,0,0,1,4,2,1,5,3,4,1,7,1,5,9,15,0}
        }
        // Repeat the pattern for the remaining 7 policies...
        // ...
    };

uint32_t  PSEL[NUM_CPUS][NUM_POLICY];  //<CPU number, policycounter1, policycounter2.......>

unsigned rand_sets[TOTAL_SDM_SETS];

void CACHE::llc_initialize_replacement()
{
    // randomly selected sampler sets
    srand(time(NULL));
    unsigned long rand_seed = 1;
    unsigned long max_rand = 1048576; //2^20
    uint32_t my_set = LLC_SET;
    int do_again = 0;                                    //Sets are not going to selected randomly [DK] means whenever we will run 
                                                        //the algorithm sampler sets are going to be same.
    for (int i=0; i<TOTAL_SDM_SETS; i++) {
        do {
            do_again = 0;            
            //rand_seed=rand()%my_set;
            //rand_sets[i] =rand_seed;
            rand_seed = rand_seed * 1103515245 + 12345;
            rand_sets[i] = ((unsigned) ((rand_seed/65536) % max_rand)) % my_set;
            printf("Assign rand_sets[%d]: %u  LLC: %u\n", i, rand_sets[i], my_set);
            for (int j=0; j<i; j++) {
                if (rand_sets[i] == rand_sets[j]) {
                    do_again = 1;
                    break;
                }
            }
        } while (do_again);
        printf("rand_sets[%d]: %d\n", i, rand_sets[i]);
    }

    for (int i=0; i<NUM_CPUS; i++)
    {
        for(int j=0;j<NUM_POLICY;j++)
        {
            PSEL[i][j] = 0;
        }
    }     
}


//promotion method
void CACHE::llc_Epromotion(uint32_t IPV[][LLC_WAY+1], uint32_t set, uint32_t way,uint8_t tp)
{
    uint32_t new_LRUpost=IPV[tp][block[set][way].lru];
    uint32_t present_LRUpost=block[set][way].lru;
            
            
            if(new_LRUpost<present_LRUpost)
            {
                for(int i=0;i<LLC_WAY;i++)
                {
                    if(new_LRUpost<=block[set][i].lru && block[set][i].lru<present_LRUpost
                     && block[set][i].valid)
                    {
                       block[set][i].lru++;
                    }
                }

            }
            else if(new_LRUpost>present_LRUpost)
            {
                for(int i=0;i<LLC_WAY;i++)
                {
                    if(present_LRUpost<block[set][i].lru && block[set][i].lru<=new_LRUpost && block[set][i].valid)
                    {
                        block[set][i].lru--;
                    }
                }
            }
            block[set][way].lru=new_LRUpost;
}


//Insertion method
void CACHE::llc_Einsertion(uint32_t IPV[][LLC_WAY+1],uint32_t set, uint32_t way,uint8_t tp)
{
    uint32_t insert_LRUpost=IPV[tp][LLC_WAY];
        for(int i=0;i<LLC_WAY;i++)
        {
            if(block[set][i].lru>=insert_LRUpost && block[set][i].lru < LLC_WAY-1)
            {
                block[set][i].lru++;      
            }
        }
        block[set][way].lru=insert_LRUpost;
}


int is_it_leader(uint32_t cpu, uint32_t set)
{
   uint32_t start = cpu * NUM_POLICY * SDM_SIZE,
             end = start + NUM_POLICY * SDM_SIZE;

    for (uint32_t i=start; i<end; i++)
        if (rand_sets[i] == set)
            return ((i - start) / SDM_SIZE);

    return -1;
}

//geting the policy which is having minimum counter value.
uint32_t min_PSEL(uint32_t temp[])
{
    uint32_t min=0;
    for(uint32_t i=1;i<NUM_POLICY;i++)
    {
        if(temp[i]<temp[min])
        {
            min=i;
        }
    }
    return min;
}

//checking if any counter is full or not.
bool is_any_counterFull(uint32_t temp[])
{
    for(int i=0;i<NUM_POLICY;i++)
    {
        if(temp[i]==PSEL_MAX)
        {
            return true;
        }
    }
    return false;
}

//halved the all counter's value if any of the counter is full
void update_PSELcounter(uint32_t temp[])
{
    for(int i=0;i<NUM_POLICY;i++)
    {
        temp[i]=temp[i]/2;
    }
}

void CACHE::llc_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit)
{
    // do not update replacement state for writebacks
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    int leader = is_it_leader(cpu, set); //Finding the given set is leader set or not.

	// cache hit
	if (hit) //promotion  
    { 
        if(leader==-1) //follower sets
        {
            uint32_t policy=min_PSEL(PSEL[cpu]);
            if(block[set][way].prefetch==1)
            {
                    //call promotion function with prefetch vector
                llc_Epromotion(RPIPV[policy],set,way,1);
                PVCP++;
            }
            else if(block[set][way].prefetch==0)
            {
                    //call promotion function with demand vector
                llc_Epromotion(RPIPV[policy],set,way,0);
                DVCP++;
            }
        }

        else if(0<=leader&&leader<NUM_POLICY)
        {
            //call prmotion functions
            if(block[set][way].prefetch==1)
            {
                    //call promotion function with prefetch vector
                llc_Epromotion(RPIPV[leader],set,way,1);
                PVCP++;
            }
            else if(block[set][way].prefetch==0)
            {
                    //call promotion function with demand vector
                llc_Epromotion(RPIPV[leader],set,way,0);
                DVCP++;
            }
        }

        else
        {
            //should not reach here
            assert(0);
        }

	}

	// cache miss
    else //insertion
    {
        // write the code here for finding set is leader or follower.
       
       bool is_full=is_any_counterFull(PSEL[cpu]);
       if(is_full)
       {
            update_PSELcounter(PSEL[cpu]);
       }
       
       if(leader==-1)//follower sets
        {
            uint32_t policy=min_PSEL(PSEL[cpu]);
            if(type==PREFETCH)
            {
                    //call insert function with prefetch vector
                llc_Einsertion(RPIPV[policy], set, way,1); 
                PVCI++;
            }
            else if(type!=PREFETCH)
            {
                //call insert function with demand vector
                llc_Einsertion(RPIPV[policy], set, way,0); 
                DVCI++;
            }
        }

        else if(0<=leader&&leader<NUM_POLICY)
        {
            PSEL[cpu][leader]++;  //PSEL[cpu][leader];
            if(type==PREFETCH)
            {
                //call insert function with prefetch vector
                llc_Einsertion(RPIPV[leader], set, way,1); 
                PVCI++;
            }
            else if(type!=PREFETCH)
            {
                //call insert function with demand vector
                llc_Einsertion(RPIPV[leader], set, way,0); 
                DVCI++;
            } 
        }

        else
        {
            //should not reach here
            assert(0);
        }
    }

}

// find replacement victim
uint32_t CACHE::llc_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // LRU block will be evicted
    uint32_t way = 0;

    // fill invalid line first
    for (way=0; way<LLC_WAY; way++) {
        if (block[set][way].valid == false) {
            break;
        }
    }

    // LRU victim
    if (way == LLC_WAY) {
        for (way=0; way<LLC_WAY; way++) {
            if (block[set][way].lru == LLC_WAY-1) {
                break;
            }
            //cout<<block[set][way].lru<<" ";
        }
    }

    if (way == LLC_WAY) {
        cerr << "[" << NAME << "] " << __func__ << " no victim! set: " << set << endl;
        assert(0);
    }
    return way;
}

