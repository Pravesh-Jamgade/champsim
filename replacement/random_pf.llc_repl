// find replacement victim
uint32_t CACHE::llc_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    random_device rd;  // A random seed source

    mt19937 generator(rd());  // Mersenne Twister PRNG
    vector<int> pf_block;

    uniform_int_distribution<int> distribution(0, LLC_WAY-1);  // Uniform distribution between 0 and 15 inclusive
  
   uint32_t way = 0;

    // finding the prefetch block first.
    for (way=0; way<LLC_WAY; way++)
    {
        if (block[set][way].prefetch == true) 
        {
           
           pf_block.push_back(way);
        }
    }
    int pf_size=pf_block.size();
    if(pf_size>0)
    {
        int rand_pfway = distribution(generator)%pf_size;
        return pf_block[rand_pfway];
    }

    way = distribution(generator); 
    if(way<LLC_WAY)
        return way;
    
    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

