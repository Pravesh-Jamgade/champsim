#include "cache.h"
#include <cstdlib>
#include <ctime>
int count=0;
map<uint64_t,uint32_t>Demand; //<PC,LRU Distance>
map<uint64_t,uint32_t>Prefetch;

void CACHE :: promotion(uint32_t set, uint32_t way, int new_LRUpost, uint32_t present_LRUpost)
{
            
    if(new_LRUpost<present_LRUpost)
    {
        for(int i=0;i<LLC_WAY;i++)
        {
            if(new_LRUpost<=block[set][i].lru && block[set][i].lru<present_LRUpost
                && block[set][i].valid)
            {
                block[set][i].lru++;
            }
        }

    }
    else if(new_LRUpost>present_LRUpost)
    {
        for(int i=0;i<LLC_WAY;i++)
        {
            if(present_LRUpost<block[set][i].lru && block[set][i].lru<=new_LRUpost && block[set][i].valid)
            {
                block[set][i].lru--;
            }
        }
    }
    block[set][way].lru=new_LRUpost;
}

void CACHE::insertion(uint32_t set, uint32_t way, uint32_t insert_LRUposition)
{
        for(int i=0;i<LLC_WAY;i++)
        {
            if(block[set][i].lru>=insert_LRUposition && block[set][i].lru < LLC_WAY-1)
            {
                block[set][i].lru++;      
            }
        }
        block[set][way].lru=insert_LRUposition;
}
void CACHE::llc_initialize_replacement()
{  }

// find replacement victim
uint32_t CACHE::llc_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // LRU block will be evicted
    uint32_t way = 0;
    int max_lru=0;
    uint32_t find_way=0;
    bool flag=false;

    // fill invalid line first
    for (way=0; way<LLC_WAY; way++) {
        if (block[set][way].valid == false) {
            return way;
        }
    }

    // LRU victim

    for (way=0; way<LLC_WAY; way++) {
        if(block[set][way].lru>=max_lru)
        {
            max_lru=block[set][way].lru;
            find_way=way;
            flag=true;
            
        }
    }

    if(flag==true)
    {
       auto  it=Demand.find(block[set][find_way].ip);
       if(it!=Demand.end())
       {
            uint32_t old_lru_distance=it->second;
            uint32_t present_lru_position=block[set][find_way].lru;
            uint32_t new_lru_distance=(old_lru_distance + present_lru_position)/2;
            it->second=new_lru_distance;
            
       }
       //cout<<block[set][find_way].lru<<" ";
       //cout<<find_way<<" ";
       return find_way;
    }

    
    cerr << "[" << NAME << "] " << __func__ << " no victim! set: " << set<<" "<<find_way<<" "<<flag<<endl;
    assert(0);
    
    //On getting evicted we need to update the table "block[set][way].ip" 
    //new LRU distance=(old LRU distance + evicted LRU position)/2
}

// called on every cache hit and cache fill
void CACHE::llc_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    //cout << "CPU: " << cpu << "  LLC " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    //cout << hex << " paddr: " << setw(12) << full_addr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;
    

    if (hit)
    {
        //On being hit we need to update the entry of the table associated with the requested PC "block[set][way].ip"
        //before updating, get the LRU distance and promote the block to the suggested position then perform the updation.
        //new LRU distance=old LRU distance + present LRU position.
        //promoted positon=present LRU Position - old LRU distance.
        //if difference negative then promoted position will be 0.
        if(type==PREFETCH)
        {
            auto itp=Prefetch.find(block[set][way].ip);
            if(itp!=Prefetch.end())
            {
                //Check if Prefetch ip exist in the Demand map or not.
                //if not exist then promote the block the lru position.
                //if exist then promote the prefetch block to the suggested LRU Distance. 
            }
        }
        else{
            auto it=Demand.find(block[set][way].ip);
            if(it!=Demand.end())
            {
                uint32_t old_lru_distance=it->second;
                uint32_t present_lru_position=block[set][way].lru;
                int promoted_position= present_lru_position - old_lru_distance;
                //cout<<promoted_position<<" ";
                uint32_t new_lru_distance=(old_lru_distance + present_lru_position)/2;
                //cout<<new_lru_distance<<" ";
                it->second=new_lru_distance;
                if(promoted_position<0)
                {
                    for (uint32_t i=0; i<NUM_WAY; i++) {
                        if (block[set][i].lru < block[set][way].lru) {
                            block[set][i].lru++;
                        }
                    }
                    block[set][way].lru=0;
            
                }
                else
                {
                    promotion(set,way,promoted_position,present_lru_position);
                }
            }
        }
        
        
    }  
    else 
    {
        //Create a new entry into the table for ip "block[set][way].ip" if that ip is not present 
        //if present then insert that block at the LRU position which will be suggested by table.
        //DK----------------------------------DK//
        //PC entry does not exist ..just insert it otherwise it is present then don't do anything.
        //DK--------------------------------DK//  
        auto it=Demand.find(ip); 
        if(it!=Demand.end())
        {
            insertion(set,way,it->second);
            //cout<<it->second<<" ";
        }
        else
        {
            Demand[ip]=0;
            for (uint32_t i=0; i<NUM_WAY; i++) {
                if (block[set][i].lru < block[set][way].lru) {
                    block[set][i].lru++;
                }
            }
            block[set][way].lru=0;
        }
        
    }

}

// use this function to print out your own stats at the end of simulation
void CACHE::llc_replacement_final_stats()
{
   
  string fileName1 = "LRU Distance.txt";
  // Open the file for writing
  std::ofstream outFile1(fileName1, ios::trunc);
  // Check if the file is open
  if (!outFile1.is_open()) 
  {
    std::cerr << "Error opening file: " << fileName1 << std::endl;
  }

  outFile1 <<left<<setw(20) << "PC " <<setw(20) << "LRU Diistance"<<endl;
  outFile1 <<setw(100) <<setfill('-') << "" <<setfill(' ') <<endl;
  
  for (const auto& pair : Demand) 
  {
    outFile1 << left <<setw(20) <<pair.first << setw(20) << pair.second<<endl;
  }
    // Close the file
    outFile1.close();
    
}
